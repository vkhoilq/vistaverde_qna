{
  "name": "vistaverde-qna",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public read-only Q&A site for Vista Verde residents, backed by Google Sheets.",
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "secret:key": "wrangler secret put SHEETS_API_KEY",
