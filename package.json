    "check:sheet": "node scripts/check-sheet.ts",
    "seed": "node scripts/seed.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251111.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
